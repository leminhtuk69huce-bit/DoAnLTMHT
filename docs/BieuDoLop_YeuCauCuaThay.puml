@startuml
skinparam defaultFontName "Segoe UI"
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam packageFontSize 13
skinparam roundCorner 8
skinparam shadowing false
skinparam classFontStyle bold

skinparam package {
    BorderColor #1E40AF
    BorderThickness 1.5
    FontSize 13
    FontStyle bold
    BackgroundColor #F8FAFC
    FontColor #0F172A
}

skinparam class {
    BackgroundColor #FFFFFF
    ArrowColor #2563EB
    BorderColor #0284C7
    BorderThickness 1.5
    HeaderBackgroundColor #E0F2FE
    FontColor #0C4A6E
    AttributeFontColor #1E293B
    AttributeFontSize 11
}

title BIỂU ĐỒ LỚP HỆ THỐNG MẠNG CLIENT - SERVER (CHUẨN KIẾN TRÚC THẦY BÙI PHONG)

' ========================================================
' PHÂN HỆ CLIENT
' ========================================================
package "Phân hệ Client (Client Side)" {
    class Socket as "Socket" {
        # sockDesc : int
        # keepAlive : bool
        --
        + virtual ~Socket()
        + virtual close() : void
        + getLocalAddress() : string
        + getLocalPort() : unsigned short
        + {static} startUp() : void
        + {static} cleanUp() : void
    }

    class TCPSocket as "TCPSocket" {
        --
        + TCPSocket()
        + TCPSocket(remoteAddress : string, port : unsigned short)
        + TCPSocket(newConnSD : int)
        + connect(remoteAddress : string, port : unsigned short) : void
        + send(buffer : const void*, bufferLen : int) : int
        + recv(buffer : void*, bufferLen : int) : int
        + recvLine(buffer : char*, bufferLen : int) : int
        + close() : void
    }

    class TCPClient as "TCPClient" {
        # localsocket : TCPSocket
        # connected : bool
        --
        + TCPClient()
        + virtual ~TCPClient()
        + open(serverHost : string, port : unsigned short) : bool
        + close() : void
        + isConnected() : bool
        # sendStringRequest(request : string) : int
        # recvGetLine(buf : char*, maxLen : unsigned int) : int
    }

    class FTPClient as "FTPClient\n(ChargeClient / AppClient)" {
        - downloadDir : string = "client_downloads"
        --
        + FTPClient()
        + login(host : string, port : unsigned short, user : string, pass : string) : bool
        + listFiles(folder : string) : vector<string>
        + downloadFile(remotePath : string) : bool
        + bulkDownload(folder : string) : void
        + quit() : void
    }

    class CLI as "CmdLineInterface\n(CLI)" {
        # cmdPrompt : string
        # bRunning : bool
        --
        + CmdLineInterface(prompt : string)
        + addCmd(name : string, f : CLI_CMD_FUNC) : void
        + run() : void
        + showCmdPrompt() : void
    }

    class FTPClientCLI as "FTPClientCLI\n(ChargeClientCLI)" {
        - client : FTPClient
        --
        + FTPClientCLI()
        + initCmd() : void
        + doLogin(argv : string[], argc : int) : void
        + doList(argv : string[], argc : int) : void
        + doGet(argv : string[], argc : int) : void
        + doMGet(argv : string[], argc : int) : void
        + doQuit(argv : string[], argc : int) : void
    }

    Socket <|-- TCPSocket : kế thừa
    TCPClient *-- TCPSocket : chứa localsocket
    TCPClient <|-- FTPClient : kế thừa
    CLI <|-- FTPClientCLI : kế thừa
    FTPClientCLI --> FTPClient : điều khiển
}

' ========================================================
' PHÂN HỆ SERVER
' ========================================================
package "Phân hệ Server (Server Side)" {
    class ServerSocketBase as "Socket" {
        # sockDesc : int
        --
        + virtual close() : void
        + {static} startUp() : void
        + {static} cleanUp() : void
    }

    class ServerTCPSocket as "TCPSocket" {
        --
        + send(buffer : const void*, bufferLen : int) : int
        + recv(buffer : void*, bufferLen : int) : int
        + recvLine(buffer : char*, bufferLen : int) : int
        + close() : void
    }

    class TCPServerSocket as "TCPServerSocket" {
        --
        + TCPServerSocket()
        + setListen(port : unsigned short, queueLen : int) : void
        + accept(timeout : long) : TCPSocket
        + close() : void
    }

    class TCPServer as "TCPServer" {
        # master : TCPServerSocket
        # conf : ServerConfig*
        # running : bool
        # port : unsigned short
        --
        + TCPServer(localPort : unsigned short)
        + virtual ~TCPServer()
        + virtual start() : bool
        + virtual stop() : void
        # run() : void
        # {abstract} startNewSession(slave : TCPSocket) : void
        # addCmd(cmdName : string, f : CMD_FUNC) : void
    }

    class FTPServer as "FTPServer\n(ChargeServer / AppServer)" {
        --
        + FTPServer(port : unsigned short = 21)
        + configServer() : bool
        # startNewSession(slave : TCPSocket) : void
        # initCmd() : void
    }

    class Session as "Session" {
        # slave : TCPSocket
        # conf : ServerConfig*
        # quitSession : bool
        --
        + Session(slave : TCPSocket, conf : ServerConfig*)
        + virtual ~Session()
        + {abstract} doUnknown(argv : string[], argc : int) : void
        + isQuit() : bool
    }

    class FTPSession as "FTPSession" {
        - isLoggedIn : bool
        - username : string
        --
        + FTPSession(slave : TCPSocket, conf : ServerConfig*)
        + doUser(argv : string[], argc : int) : void
        + doPass(argv : string[], argc : int) : void
        + doPasv(argv : string[], argc : int) : void
        + doList(argv : string[], argc : int) : void
        + doRetr(argv : string[], argc : int) : void
        + doQuit(argv : string[], argc : int) : void
    }

    class Account as "Account" {
        # username : string
        - password : string
        --
        + Account(username : string)
        + getUserName() : string
        + setPassword(pass : string) : void
        + isValidPassword(pass : string) : bool
    }

    class ServerConfig as "ServerConfig" {
        # timeout : int
        # accMap : unordered_map<string, Account*>
        --
        + addAccount(acc : Account*) : void
        + getAccount(username : string) : Account*
        + authenticate(user : string, pass : string) : bool
        + {abstract} loadAccountsFromFile(file : string) : bool
    }

    class FTPServerConfig as "FTPServerConfig" {
        + rootDir : string = "server_files"
        --
        + loadAccountsFromFile(file : string) : bool
    }

    class ServerCLI as "CmdLineInterface\n(CLI)" {
        # bRunning : bool
        --
        + run() : void
        + addCmd(...) : void
    }

    class FTPServerCLI as "FTPServerCLI\n(ChargeServerCLI)" {
        - server : FTPServer*
        --
        + FTPServerCLI()
        + initCmd() : void
        + doStart(argv : string[], argc : int) : void
        + doStop(argv : string[], argc : int) : void
        + doAddUser(argv : string[], argc : int) : void
        + doUsers(argv : string[], argc : int) : void
    }

    ServerSocketBase <|-- ServerTCPSocket : kế thừa
    ServerSocketBase <|-- TCPServerSocket : kế thừa
    TCPServer *-- TCPServerSocket : chứa master
    TCPServer <|-- FTPServer : kế thừa
    Session *-- ServerTCPSocket : chứa slave
    Session <|-- FTPSession : kế thừa
    ServerConfig o-- Account : chứa danh sách
    ServerConfig <|-- FTPServerConfig : kế thừa
    FTPServer --> FTPServerConfig : sử dụng cấu hình
    FTPServer --> FTPSession : quản lý phiên
    ServerCLI <|-- FTPServerCLI : kế thừa
    FTPServerCLI --> FTPServer : điều khiển
}

@enduml